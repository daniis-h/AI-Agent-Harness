{
  "name": "agent-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "demo": "node --env-file-if-exists=.env src/demo.ts",
    "demo:workspace": "node --env-file-if-exists=.env src/demo-workspace.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "description": "Build an AI agent harness from scratch in TypeScript: the agent loop, tool validation, a safe workspace. Zero runtime dependencies.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "ai-agent",
    "agent-harness",
    "typescript",
    "llm",
    "tool-calling",
    "nodejs",
    "tutorial"
  ]
}
