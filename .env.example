# Copy to .env (npm run setup does it for you). Never commit .env.

# The ONLY folder the agent's file tools may read or write.
AGENT_WORKSPACE=./workspace

# How many model turns one run may take (the step limit from lecture 1).
AGENT_MAX_STEPS=10

